#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
ROOT_DIR=$(realpath "$SCRIPT_DIR/../../../")
. "$ROOT_DIR/scripts/_base.sh"
cd "$SCRIPT_DIR"

NAMESPACES=("production" "staging")

# Parse command line arguments
BACKUP_FILE=""

usage() {
	echo "Usage: $0 [-n namespace] [-f backup_file]"
	echo ""
	echo "Options:"
	echo "  -n    Namespace (staging or production, default: will prompt)"
	echo "  -f    Specific backup file to restore (default: will prompt from available backups)"
	echo ""
	echo "Examples:"
	echo "  $0 -n production                               # Interactive backup selection"
	echo "  $0 -n staging -f /data/backups/backup.sql.gz   # Restore specific backup"
	exit 1
}

while [[ $# -gt 0 ]]; do
	case $1 in
	-n)
		NAMESPACE="$2"
		shift 2
		;;
	-f)
		BACKUP_FILE="$2"
		shift 2
		;;
	-h | --help)
		usage
		;;
	*)
		echo "Unknown option: $1"
		usage
		;;
	esac
done

# Select namespace if not provided
if [ -z "${NAMESPACE:-}" ]; then
	NAMESPACE=$(choose_option "Choose namespace:" "${NAMESPACES[@]}")
fi

title "Immich Database Restore"
info "Namespace: ${NAMESPACE}"
echo ""

# Check if postgres cluster exists
if ! kubectl get cluster immich-postgres -n "$NAMESPACE" >/dev/null 2>&1; then
	error "ERROR: immich-postgres cluster not found in namespace ${NAMESPACE}"
	exit 1
fi

# Get database credentials first (needed for restore pod)
section "Retrieving database credentials..."
DB_HOST=$(kubectl get secret immich-postgres-superuser -n "$NAMESPACE" -o jsonpath='{.data.host}' | base64 -d)
DB_USER=$(kubectl get secret immich-postgres-superuser -n "$NAMESPACE" -o jsonpath='{.data.user}' | base64 -d)
DB_PASS=$(kubectl get secret immich-postgres-superuser -n "$NAMESPACE" -o jsonpath='{.data.password}' | base64 -d)
DB_NAME="immich"

success "Database host: ${DB_HOST}"

# Get library PVC name from the Helm release
section "Finding library PVC..."
LIBRARY_PVC=$(kubectl get helmrelease immich -n "$NAMESPACE" -o jsonpath='{.spec.values.immich.persistence.library.existingClaim}' 2>/dev/null)

if [ -z "$LIBRARY_PVC" ]; then
	# Fallback: try to find PVC by name pattern (must contain "library" but not "external")
	LIBRARY_PVC=$(kubectl get pvc -n "$NAMESPACE" -o name | grep -i library | grep -v external | sed 's|persistentvolumeclaim/||' | head -1)
fi

if [ -z "$LIBRARY_PVC" ]; then
	error "ERROR: Could not find Immich library PVC in namespace ${NAMESPACE}"
	exit 1
fi

success "Found library PVC: ${LIBRARY_PVC}"

# Create restore pod with library PVC mounted (used for both listing and restoring)
section "Creating restore pod with library PVC mounted..."
POSTGRES_IMAGE=$(kubectl get cluster immich-postgres -n "$NAMESPACE" -o jsonpath='{.spec.instances[0].imageName}' 2>/dev/null || echo "ghcr.io/cloudnative-pg/postgresql:16")

# Clean up any existing restore pod
kubectl delete pod immich-postgres-restore -n "$NAMESPACE" --wait=false 2>/dev/null || true
sleep 2

cat <<EOF | kubectl apply -f -
apiVersion: v1
kind: Pod
metadata:
  name: immich-postgres-restore
  namespace: $NAMESPACE
spec:
  containers:
  - name: restore
    image: $POSTGRES_IMAGE
    command: ["sleep", "infinity"]
    env:
    - name: PGPASSWORD
      value: "$DB_PASS"
    - name: PGHOST
      value: "$DB_HOST"
    - name: PGUSER
      value: "$DB_USER"
    - name: PGDATABASE
      value: "postgres"
    volumeMounts:
    - name: library
      mountPath: /data
      readOnly: true
  volumes:
  - name: library
    persistentVolumeClaim:
      claimName: $LIBRARY_PVC
  restartPolicy: Never
EOF

info "Waiting for restore pod to be ready..."
kubectl wait --for=condition=ready pod/immich-postgres-restore -n "$NAMESPACE" --timeout=60s

# If no backup file specified, list available backups and let user choose
if [ -z "$BACKUP_FILE" ]; then
	section "Finding available database backups..."

	# Get list of backup files
	BACKUP_FILES=$(kubectl exec -n "$NAMESPACE" immich-postgres-restore -- \
		sh -c 'find /data/backups -name "*.sql.gz" -o -name "*.sql" 2>/dev/null | sort -r' || echo "")

	if [ -z "$BACKUP_FILES" ]; then
		error "ERROR: No database backups found in /data/backups/"
		kubectl delete pod immich-postgres-restore -n "$NAMESPACE" --wait=false 2>/dev/null || true
		exit 1
	fi

	# Convert to array
	mapfile -t BACKUP_ARRAY <<<"$BACKUP_FILES"

	# Show selection with latest as default
	BACKUP_FILE=$(choose_option "Choose backup file (latest first):" "${BACKUP_ARRAY[@]}")

	success "Selected backup: ${BACKUP_FILE}"
else
	# If user specified a filename without path, prepend /data/backups/
	if [[ "$BACKUP_FILE" != /* ]]; then
		BACKUP_FILE="/data/backups/$BACKUP_FILE"
	fi

	info "Backup file: ${BACKUP_FILE}"
fi

# Confirmation prompt
echo ""
error "WARNING: This will restore the Immich database from backup!"
error "The existing database will be DROPPED and recreated by the backup file."
warn "Backup file: ${BACKUP_FILE}"
warn "Note: Immich will continue running during the restore. You may experience errors during this time."
echo ""
if [[ "$(ask_yes_no "Are you sure you want to continue?" "n")" != "y" ]]; then
	warn "Restore cancelled."
	kubectl delete pod immich-postgres-restore -n "$NAMESPACE" --wait=false 2>/dev/null || true
	exit 0
fi
echo ""

# Terminate existing database connections
section "Terminating existing database connections..."
kubectl exec -n "$NAMESPACE" immich-postgres-1 -- \
	psql -U "$DB_USER" -d postgres -c "SELECT pg_terminate_backend(pg_stat_activity.pid) FROM pg_stat_activity WHERE pg_stat_activity.datname = '${DB_NAME}' AND pid <> pg_backend_pid();" 2>/dev/null || true

sleep 2

# Restore the backup
section "Restoring database from backup..."
info "This may take a few minutes depending on the backup size..."

# Run restore with sed processing inside the pod to avoid line truncation through kubectl pipes
kubectl exec -n "$NAMESPACE" immich-postgres-restore -- bash -c "
set -euo pipefail
if [[ '$BACKUP_FILE' == *.gz ]]; then
	gunzip -c '$BACKUP_FILE' | \
		sed -e \"s/SELECT pg_catalog.set_config('search_path', '', false);/SELECT pg_catalog.set_config('search_path', 'public, pg_catalog', false);/g\" \
			-e \"/^DROP ROLE IF EXISTS postgres;/d\" \
			-e \"/^CREATE ROLE postgres;/d\" \
			-e \"/^ALTER ROLE postgres /d\" | \
		psql --set ON_ERROR_STOP=1
else
	cat '$BACKUP_FILE' | \
		sed -e \"s/SELECT pg_catalog.set_config('search_path', '', false);/SELECT pg_catalog.set_config('search_path', 'public, pg_catalog', false);/g\" \
			-e \"/^DROP ROLE IF EXISTS postgres;/d\" \
			-e \"/^CREATE ROLE postgres;/d\" \
			-e \"/^ALTER ROLE postgres /d\" | \
		psql --set ON_ERROR_STOP=1
fi
"

RESTORE_EXIT_CODE=$?

# Cleanup restore pod
section "Cleaning up restore pod..."
kubectl delete pod immich-postgres-restore -n "$NAMESPACE" --wait=false || true

if [ $RESTORE_EXIT_CODE -ne 0 ]; then
	error "ERROR: Database restore failed with exit code ${RESTORE_EXIT_CODE}"
	error "Check the logs above for details. The database may be in an inconsistent state."
	exit 1
fi

success "Database restored successfully!"

# Restart the server if it's running
if kubectl get deployment immich-server -n "$NAMESPACE" >/dev/null 2>&1; then
	section "Restarting Immich server to reconnect to restored database..."
	kubectl rollout restart deployment/immich-server -n "$NAMESPACE"

	section "Waiting for deployment to be ready..."
	kubectl rollout status deployment/immich-server -n "$NAMESPACE" --timeout=300s || true
fi

title "Database Restore Complete"
success "Database has been restored successfully."
