#!/bin/bash
set -euo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
ROOT_DIR="$(realpath $SCRIPT_DIR/../../../../)"
. $ROOT_DIR/scripts/_base.sh
cd $SCRIPT_DIR

if [ "$(basename $KUBECONFIG)" != "config" ]; then
    warn "$(s yellow KUBECONFIG) is not set to '$(s blue config)'"
    read -p "Are you sure to coninue? [y/N] " -n 1 -r
    echo    # (optional) move to a new line
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        error "Aborted."
        exit 1
    fi
fi

title "Generate local certificates"
DOMAIN=$(grep -m1 '^DOMAIN=' "$SCRIPT_DIR/.env" | cut -d '=' -f2-)
$ROOT_DIR/scripts/bin/bui-local-certs "$DOMAIN"

title "Update immich values"
$ROOT_DIR/scripts/immich/bui-immich-update-config "local"

echo $(s d "=============================================")
title "Apply kustomization"
echo "$(s d kubectl apply -k $(realpath --relative-to="." $SCRIPT_DIR))"
echo
kubectl apply -k "$SCRIPT_DIR"
success "DONE"

title "Show pods"
echo "$(s d kubectl get pods -n immich)"
kubectl get pods -n immich
