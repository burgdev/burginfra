#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
ROOT_DIR=$(realpath "$SCRIPT_DIR/../../../")
. "$ROOT_DIR/scripts/_base.sh"
cd "$SCRIPT_DIR"

# Default values
NAMESPACE="burginfra-system"
CLUSTER=""
OPENBAO_POD=""
SERVICE_ACCOUNT="openbao-config-manager"
ADMIN_NAMESPACES="staging,production,burginfra-system,burginfra-staging,flux-system"
RECOVERY_SHARES=1
RECOVERY_THRESHOLD=1

usage() {
	cat <<EOF
Usage: $0 -c CLUSTER [-n NAMESPACE] [-s SA_NAME] [-a NAMESPACES] [-r SHARES] [-t THRESHOLD]

This script performs the initial bootstrap of OpenBao:
  1. Initializes OpenBao if not already initialized
  2. Enables Kubernetes authentication
  3. Creates an admin role for configuration management (for the service account '$SERVICE_ACCOUNT')

This should be run ONCE when setting up OpenBao.

Requirements:
  - OpenBao must be deployed
  - The '$SERVICE_ACCOUNT' ServiceAccount must exist in the namespace

Options:
    -c CLUSTER      Cluster context name (required)
    -n NAMESPACE    Kubernetes namespace where OpenBao is running (default: $NAMESPACE)
    -s SA_NAME      Service account name for config jobs, this must already exist in kubernetes (default: $SERVICE_ACCOUNT)
    -a NAMESPACES   Comma-separated namespaces for admin role (default: $ADMIN_NAMESPACES)
    -r SHARES       Number of recovery key shares (default: $RECOVERY_SHARES, only used if init is required)
    -t THRESHOLD    Recovery key threshold (default: $RECOVERY_THRESHOLD, only used if init is required)
    -h              Show this help message

Example:
    $0 -c local
    $0 -c burginfra-system -s openbao-master-service
EOF
	exit 1
}

while getopts "n:c:s:a:r:t:h" opt; do
	case $opt in
	n) NAMESPACE="$OPTARG" ;;
	c) CLUSTER="$OPTARG" ;;
	s) SERVICE_ACCOUNT="$OPTARG" ;;
	a) ADMIN_NAMESPACES="$OPTARG" ;;
	r) RECOVERY_SHARES="$OPTARG" ;;
	t) RECOVERY_THRESHOLD="$OPTARG" ;;
	h) usage ;;
	*) usage ;;
	esac
done

# Validate required arguments
if [ -z "$CLUSTER" ]; then
	error "-c CLUSTER is required"
	usage
fi

# Validate recovery shares and threshold
if ! [[ "$RECOVERY_SHARES" =~ ^[0-9]+$ ]] || [ "$RECOVERY_SHARES" -lt 1 ]; then
	error "Recovery shares must be a positive number"
	exit 1
fi

if ! [[ "$RECOVERY_THRESHOLD" =~ ^[0-9]+$ ]] || [ "$RECOVERY_THRESHOLD" -lt 1 ]; then
	error "Recovery threshold must be a positive number"
	exit 1
fi

if [ "$RECOVERY_THRESHOLD" -gt "$RECOVERY_SHARES" ]; then
	error "Recovery threshold ($RECOVERY_THRESHOLD) cannot be greater than recovery shares ($RECOVERY_SHARES)"
	exit 1
fi

title "OpenBao Bootstrap - Initial Configuration"
info "This script will initialize and configure OpenBao"
info "Target namespace: $NAMESPACE"
if [ "$RECOVERY_SHARES" -gt 1 ]; then
	info "Recovery configuration: $RECOVERY_SHARES shares, $RECOVERY_THRESHOLD threshold"
fi
echo ""

cluster_check "$CLUSTER"

# Check if namespace exists
if ! kubectl get namespace "$NAMESPACE" &>/dev/null; then
	error "Namespace '$NAMESPACE' does not exist"
	exit 1
fi
success "Namespace '$NAMESPACE' exists"

# Check if service account exists
if ! kubectl get serviceaccount "$SERVICE_ACCOUNT" -n "$NAMESPACE" &>/dev/null; then
	error "ServiceAccount '$SERVICE_ACCOUNT' does not exist in namespace '$NAMESPACE'"
	info "Please create it first or specify a different service account with -s"
	exit 1
fi
success "ServiceAccount '$SERVICE_ACCOUNT' exists"

# Find OpenBao pod
info "Looking for OpenBao pod in namespace '$NAMESPACE'..."
OPENBAO_POD=$(kubectl get pod -n "$NAMESPACE" -l app.kubernetes.io/name=openbao -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || true)

if [ -z "$OPENBAO_POD" ]; then
	error "Could not find OpenBao pod in namespace '$NAMESPACE'"
	info "Make sure OpenBao is deployed with label 'app.kubernetes.io/name=openbao'"
	exit 1
fi
success "Found OpenBao pod: $OPENBAO_POD"

# Check if pod exists and we can exec into it (don't check Ready status)
info "Checking if we can connect to OpenBao pod..."
if ! kubectl exec -n "$NAMESPACE" "$OPENBAO_POD" -- echo "test" &>/dev/null; then
	error "Cannot exec into OpenBao pod - pod may not be running yet"
	info "Current pod status:"
	kubectl get pod "$OPENBAO_POD" -n "$NAMESPACE"
	exit 1
fi
success "Can connect to OpenBao pod"

echo ""
title "Configuring OpenBao"

# Create a temporary script to run inside the pod
TEMP_SCRIPT=$(mktemp)
TEMP_OUTPUT=$(mktemp)
trap "rm -f $TEMP_SCRIPT $TEMP_OUTPUT" EXIT

cat >"$TEMP_SCRIPT" <<'EOFSCRIPT'
#!/bin/sh
set -e

export BAO_ADDR="http://localhost:8200"
NAMESPACE="$1"
SERVICE_ACCOUNT="$2"
ADMIN_NAMESPACES="$3"
RECOVERY_SHARES="$4"
RECOVERY_THRESHOLD="$5"

echo "==> Checking OpenBao status..."

# Check if OpenBao is initialized
if bao status 2>&1 | grep -q "Vault is not initialized"; then
    echo "OpenBao is not initialized. Initializing now..."
    echo "Recovery shares: $RECOVERY_SHARES, threshold: $RECOVERY_THRESHOLD"
    echo ""

    # Initialize OpenBao
    INIT_OUTPUT=$(bao operator init \
        -recovery-shares="$RECOVERY_SHARES" \
        -recovery-threshold="$RECOVERY_THRESHOLD" \
        -format=json)

    # Extract all recovery keys
    RECOVERY_KEYS=$(echo "$INIT_OUTPUT" | grep -o '"recovery_keys_b64":\[[^]]*\]' | sed 's/"recovery_keys_b64":\[//;s/\]//' | tr ',' '\n' | tr -d '"')
    ROOT_TOKEN=$(echo "$INIT_OUTPUT" | grep -o '"root_token":"[^"]*"' | cut -d'"' -f4)

    # Save to output file for script to capture
    echo "ROOT_TOKEN=$ROOT_TOKEN" > /tmp/bao-init-output.txt
    echo "RECOVERY_SHARES=$RECOVERY_SHARES" >> /tmp/bao-init-output.txt
    echo "RECOVERY_THRESHOLD=$RECOVERY_THRESHOLD" >> /tmp/bao-init-output.txt

    # Save recovery keys
    KEY_NUM=1
    echo "$RECOVERY_KEYS" | while IFS= read -r key; do
        if [ -n "$key" ]; then
            echo "RECOVERY_KEY_$KEY_NUM=$key" >> /tmp/bao-init-output.txt
            KEY_NUM=$((KEY_NUM + 1))
        fi
    done

    export BAO_TOKEN="$ROOT_TOKEN"
    NEWLY_INITIALIZED=true

    echo "✓ OpenBao initialized successfully"
else
    echo "✓ OpenBao is already initialized"
    NEWLY_INITIALIZED=false

    # If already initialized, we need the root token
    if [ -z "$BAO_TOKEN" ]; then
        echo "ERROR: OpenBao is already initialized but no root token provided"
        echo "Please set BAO_TOKEN environment variable or re-run with the root token"
        exit 1
    fi
fi

# Login with the token
echo ""
echo "==> Logging in to OpenBao..."
bao login "$BAO_TOKEN" >/dev/null 2>&1
echo "✓ Logged in successfully"

# Check if sealed
if bao status 2>&1 | grep -q "Sealed.*true"; then
    echo "ERROR: OpenBao is sealed. Please unseal it first."
    exit 1
fi
echo "✓ OpenBao is unsealed"

echo ""
echo "==> Checking Kubernetes auth..."
if bao auth list | grep -q "kubernetes/"; then
    echo "✓ Kubernetes auth already enabled"
else
    echo "Enabling Kubernetes auth..."
    bao auth enable kubernetes
    echo "✓ Kubernetes auth enabled"
fi

echo ""
echo "==> Configuring Kubernetes auth backend..."
bao write auth/kubernetes/config \
    kubernetes_host="https://kubernetes.default.svc:443" \
    kubernetes_ca_cert=@/var/run/secrets/kubernetes.io/serviceaccount/ca.crt

echo "✓ Kubernetes auth configured"

echo ""
echo "==> Creating openbao-admin policy..."

# Write the admin policy
bao policy write openbao-admin /tmp/openbao-admin.hcl

echo "✓ openbao-admin policy created"

echo ""
echo "==> Creating Kubernetes auth role for $SERVICE_ACCOUNT..."
bao write auth/kubernetes/role/openbao-admin \
    bound_service_account_names="$SERVICE_ACCOUNT" \
    bound_service_account_namespaces="$ADMIN_NAMESPACES" \
    policies=openbao-admin \
    ttl=1h

echo "✓ openbao-admin role created"

echo ""
echo "==> Verifying configuration..."
bao read auth/kubernetes/role/openbao-admin >/dev/null
echo "✓ Configuration verified"

echo ""
echo "============================================"
echo "Bootstrap complete!"
echo "============================================"
echo "The following has been configured:"
echo "  - Kubernetes auth method enabled"
echo "  - Kubernetes auth backend configured"
echo "  - openbao-admin policy created"
echo "  - openbao-admin role created"
echo ""
echo "Service Account: $SERVICE_ACCOUNT"
echo "Allowed Namespaces: $ADMIN_NAMESPACES"

if [ "$NEWLY_INITIALIZED" = "true" ]; then
    echo "NEWLY_INITIALIZED=true" >> /tmp/bao-init-output.txt
fi
EOFSCRIPT

POLICY_FILE="$SCRIPT_DIR/base/policies/openbao-admin.hcl"
if [ ! -f "$POLICY_FILE" ]; then
	echo "ERROR: Policy file not found: $POLICY_FILE"
	exit 1
fi
kubectl cp "$POLICY_FILE" "$NAMESPACE/$OPENBAO_POD:/tmp/openbao-admin.hcl" >/dev/null 2>&1
info "Executing configuration in OpenBao pod..."
echo ""

# Check if we need to provide a root token (for already initialized OpenBao)
CHECK_INIT=$(kubectl exec -n "$NAMESPACE" "$OPENBAO_POD" -- bao status 2>&1 || true)

if echo "$CHECK_INIT" | grep -q "Vault is not initialized"; then
	info "OpenBao is not initialized - will initialize now"
	PROVIDE_TOKEN=false
elif echo "$CHECK_INIT" | grep -q "Sealed.*false"; then
	warn "OpenBao is already initialized"
	info "You need to provide the root token to continue"
	echo ""

	# Prompt for root token
	prompt_for_token() {
		local attempts=0
		local max_attempts=3

		while [ $attempts -lt $max_attempts ]; do
			IFS= read -rsp "Enter OpenBao root token: " ROOT_TOKEN
			echo

			# Remove whitespace
			ROOT_TOKEN=$(printf '%s' "$ROOT_TOKEN" | tr -d '\n\r \t')

			if [ -z "$ROOT_TOKEN" ]; then
				attempts=$((attempts + 1))
				error "Token cannot be empty. Attempt $attempts of $max_attempts"
				continue
			fi

			if [ ${#ROOT_TOKEN} -lt 20 ]; then
				attempts=$((attempts + 1))
				warn "Token seems too short. Attempt $attempts of $max_attempts"
				continue
			fi

			return 0
		done

		error "Maximum attempts reached"
		return 1
	}

	if ! prompt_for_token; then
		exit 1
	fi
	PROVIDE_TOKEN=true
	echo ""
else
	error "Could not determine OpenBao status"
	info "Status output: $CHECK_INIT"
	exit 1
fi

# Copy script to pod and execute it
if kubectl cp "$TEMP_SCRIPT" "$NAMESPACE/$OPENBAO_POD:/tmp/bootstrap.sh" >/dev/null 2>&1; then
	if [ "$PROVIDE_TOKEN" = true ]; then
		# Run with provided token
		kubectl exec -n "$NAMESPACE" "$OPENBAO_POD" -- env BAO_TOKEN="$ROOT_TOKEN" sh /tmp/bootstrap.sh "$NAMESPACE" "$SERVICE_ACCOUNT" "$ADMIN_NAMESPACES" "$RECOVERY_SHARES" "$RECOVERY_THRESHOLD"
	else
		# Run without token (will initialize)
		kubectl exec -n "$NAMESPACE" "$OPENBAO_POD" -- sh /tmp/bootstrap.sh "$NAMESPACE" "$SERVICE_ACCOUNT" "$ADMIN_NAMESPACES" "$RECOVERY_SHARES" "$RECOVERY_THRESHOLD"
	fi
	EXIT_CODE=$?

	kubectl exec -n "$NAMESPACE" "$OPENBAO_POD" -- rm -f /tmp/openbao-admin.hcl >/dev/null 2>&1 || true

	# If newly initialized, capture the credentials
	if kubectl exec -n "$NAMESPACE" "$OPENBAO_POD" -- test -f /tmp/bao-init-output.txt 2>/dev/null; then
		if kubectl cp "$NAMESPACE/$OPENBAO_POD:/tmp/bao-init-output.txt" "$TEMP_OUTPUT" 2>/dev/null; then
			if grep -q "NEWLY_INITIALIZED=true" "$TEMP_OUTPUT"; then
				echo ""
				echo "============================================"
				echo "⚠️  CREDENTIALS - SAVE THESE SECURELY!"
				echo "============================================"
				echo ""

				# Parse and display credentials
				ROOT_TOKEN=$(grep "^ROOT_TOKEN=" "$TEMP_OUTPUT" | cut -d'=' -f2)
				SHARES=$(grep "^RECOVERY_SHARES=" "$TEMP_OUTPUT" | cut -d'=' -f2)
				THRESHOLD=$(grep "^RECOVERY_THRESHOLD=" "$TEMP_OUTPUT" | cut -d'=' -f2)

				echo "Root Token:"
				echo "  $ROOT_TOKEN"
				echo ""
				echo "Recovery Keys Configuration:"
				echo "  Shares: $SHARES"
				echo "  Threshold: $THRESHOLD"
				echo ""
				echo "Recovery Keys:"

				# Display all recovery keys
				grep "^RECOVERY_KEY_" "$TEMP_OUTPUT" | while IFS= read -r line; do
					KEY_NUM=$(echo "$line" | sed 's/RECOVERY_KEY_\([0-9]*\)=.*/\1/')
					KEY_VALUE=$(echo "$line" | cut -d'=' -f2)
					echo "  Key $KEY_NUM: $KEY_VALUE"
				done

				echo ""
				echo "============================================"
				echo ""
				warn "These credentials are shown only once!"
				warn "Store them in a secure location:"
				echo "  • Password manager (1Password, Bitwarden, etc.)"
				echo "  • Hardware security key"
				echo "  • Encrypted vault"
				echo "  • Kubernetes sealed secret (for automation)"
				echo ""
				info "Distribution strategy for multiple keys:"
				echo "  • Give each key to a different administrator"
				echo "  • Require $THRESHOLD key(s) to unseal/recover"
				echo "  • Store keys in different physical locations"
			fi
			kubectl exec -n "$NAMESPACE" "$OPENBAO_POD" -- rm -f /tmp/bao-init-output.txt >/dev/null 2>&1 || true
		fi
	fi

	# Clean up script from pod
	kubectl exec -n "$NAMESPACE" "$OPENBAO_POD" -- rm -f /tmp/bootstrap.sh >/dev/null 2>&1 || true

	if [ $EXIT_CODE -eq 0 ]; then
		echo ""
		success "Bootstrap completed successfully!"
		echo ""
		info "Next steps:"
		echo "  1. Save the credentials shown above (if newly initialized)"
		echo "  2. Store recovery keys with different administrators (if using Shamir)"
		echo "  3. You can now use GitOps to manage OpenBao configuration"
		echo "  4. Configuration jobs will use Kubernetes auth automatically"
		echo ""
		warn "Security recommendations:"
		echo "  • Never commit credentials to Git"
		echo "  • Use sealed secrets for automation credentials"
		echo "  • Consider rotating the root token after setup"
		echo "  • Document your key distribution strategy"
	else
		error "Bootstrap failed"
		exit $EXIT_CODE
	fi
else
	error "Failed to copy script to OpenBao pod"
	exit 1
fi
