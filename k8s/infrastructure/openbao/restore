#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
ROOT_DIR=$(realpath "$SCRIPT_DIR/../../../")
. "$ROOT_DIR/scripts/_base.sh"
cd "$SCRIPT_DIR"

NAMESPACES=("burginfra-staging" "burginfra-system")

# Source the helper: sets RESTORE_YAML and provides wait_for_restore()
source "${ROOT_DIR}/scripts/k8s/_restore.sh"

# --- Scenario-specific steps ---
echo -e "${YELLOW}Scaling down StatefulSet openbao...${RESET}"
kubectl scale statefulset openbao --replicas=0 -n "$SRC_NAMESPACE"

echo -e "${YELLOW}Applying restore manifest...${RESET}"
echo "$RESTORE_YAML" | kubectl apply -f -

wait_for_restore

echo -e "${YELLOW}Scaling StatefulSet openbao back up...${RESET}"
kubectl scale statefulset openbao --replicas=1 -n "$SRC_NAMESPACE"

sleep 5 # wait until ready

echo -e "${YELLOW}Update kubernetes config...${RESET}"
kubectl -n $SRC_NAMESPACE exec -it openbao-0 -- sh -c "
bao write auth/kubernetes/config \
  token_reviewer_jwt=\"\$(cat /var/run/secrets/kubernetes.io/serviceaccount/token)\" \
  kubernetes_host=\"https://kubernetes.default.svc:443\" \
  kubernetes_ca_cert=@/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
"

echo -e "${GREEN}Restore scenario completed successfully.${RESET}"
