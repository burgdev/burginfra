#!/bin/bash
set -euo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
ROOT_DIR="$(realpath $SCRIPT_DIR/../../)"
. $ROOT_DIR/scripts/_base.sh
ENV=${1:-local}
IMMICH_K8S_DIR="$ROOT_DIR/k8s/immich"
cd $IMMICH_K8S_DIR/

TEMPLATE=immich-values.patch.template.yaml
BASE=$IMMICH_K8S_DIR/base/immich-values.template.yaml
CONFIG=.immich-values.yaml

set -a
source $IMMICH_K8S_DIR/base/.env.template
set +a

for ENV in $(ls overlays/); do
    section "Updating '$ENV'"
    cd $IMMICH_K8S_DIR/overlays/$ENV
    REL_BASE=$(realpath --relative-to="." $BASE)
    if [ ! -f .env ]; then
        warn "No .env file found in '$ENV'"
        break
    fi
    set -a
    source .env
    set +a
    if [ ! -f $TEMPLATE ]; then
        warn "No $TEMPLATE file found in '$ENV'"
        cp $BASE $CONFIG.merge
    else
        # merge with the file in the base
        info "Merging $(s yellow $REL_BASE) and $(s yellow $TEMPLATE)"
        yq eval-all 'select(fileIndex == 0) * select(fileIndex == 1)' $BASE $TEMPLATE > $CONFIG.merge
    fi
    # Create a temporary file with the header
    echo "# $(date) -- DO NOT EDIT: Auto-generated from $TEMPLATE" > "$CONFIG"
    echo "" >> "$CONFIG"

    # Process the template and append to the file
    envsubst < "$CONFIG.merge" | sed '/^\s*\(#\|\/\)/d' >> "$CONFIG"

    info "Updated $(s d $CONFIG) from template $(s yellow $TEMPLATE) at $(s blue $(date))"
    rm $CONFIG.merge

    cd -
done
