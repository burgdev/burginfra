# yamlfmt configuration for `just check` (tasks/check.just).
#
# The check enforces yamlfmt DEFAULTS; the tree had drifted (leading `---`
# document markers, trailing blank lines). One-time reformat lands with the
# check fix that made it visible.
#
# The Flux bootstrap manifest is GENERATED by `flux bootstrap` ("DO NOT
# EDIT" header): every regeneration re-introduces its own formatting
# (CRLF, `---` separators), so reformatting it here would only create
# recurring churn — exclude it instead.
exclude:
  - "k8s/clusters/flux-system/base/gotk-components.yaml"
